ad\n    data = input().split()\n    N = int(data[0])\n    P = list(map(int, data[1:]))\n\n    # We will use a list to represent the final array\n    A = [0] * N\n\n    # We will use a Fenwick Tree to track the available positions\n    class FenwickTree:\n        def __init__(self, size):\n            self.n = size\n            self.tree = [0] * (self.n + 2)\n\n        def update(self, idx, delta):\n            while idx <= self.n:\n                self.tree[idx] += delta\n                idx += idx & -idx\n\n        def query(self, idx):\n            res = 0\n            while idx > 0:\n                res += self.tree[idx]\n                idx -= idx & -idx\n            return res\n\n        def find_kth(self, k):\n            idx = 1\n            sum = 0\n            while idx <= self.n:\n                if sum + self.tree[idx] >= k:\n                    idx += idx & -idx\n                else:\n                    sum += self.tree[idx]\n                    idx += idx & -idx\n            return idx - 1\n\n    ft = FenwickTree(N)\n    for i in range(1, N + 1):\n        pos = P[i - 1]\n        # Find the k-th available position\n        k = pos\n        idx = ft.find_kth(k)\n        A[idx] = i\n        ft.update(idx + 1, 1)\n\n    print(\' \'.join(map(str, A)))\n\nmain()</submit>\n<obs>status: fail error_type: runtime_error passed_tests: 0 failed_tests: 2 stderr_tail: Traceback (most recent call last): File "/tmp/cs639_grpo/tmp/react_bench_k0xzh7d7/solution.py", line 54, in <module> main() File "/tmp/cs639_grpo/tmp/react_bench_k0xzh7d7/solution.py", line 49, in main A[idx] = i ~^^^^^ IndexError: list assignment index out of range</obs>\n<submit>import sys\n\ndef main():\n    import sys\n    input = sys.stdin.read\n    data = input().split()\n    N = int(data[0])\n    P = list(map(int, data[1:]))\n\n    class FenwickTree:\n        def __init__(self, size):\n            self.n = size\n            self.tree = [0] * (self.n + 2)\n\n        def update(self, idx, delta):\